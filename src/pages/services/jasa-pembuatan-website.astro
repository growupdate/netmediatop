---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import { Image } from "astro:assets";

// Import gambar dummy dari folder assets
import imgWebDev from "@/assets/images/services/web-dev.webp";
import imgDevBalanced from "@/assets/images/dev_balanced.png";

const metadata = {
  title: "Jasa Pembuatan Website Cepat & High-Conversion - Netmediatop",
  description:
    "Layanan pembuatan website ultra-cepat, responsif, dan teroptimasi konversi. Jadikan pengunjung web langsung terhubung ke WhatsApp bisnis Anda tanpa ragu.",
};

const waMessage = encodeURIComponent(
  "Halo Netmediatop, saya ingin berkonsultasi mengenai pembuatan website berkecepatan tinggi untuk meningkatkan konversi bisnis saya.",
);
const waLink = `https://wa.me/6282329188998?text=${waMessage}`;
---

<BaseLayout {metadata}>
  <!-- Header / Intro Utama (Pillar Title) -->
  <Content
    tagline="Layanan Pilar"
    title="Jasa Pembuatan Website Modern, Cepat & Siap Konversi"
    description={[
      "Website Anda adalah etalase digital bisnis 24 jam. Bangun infrastruktur web berkecepatan tinggi yang dirancang khusus untuk mengubah pengunjung menjadi pembeli aktif di WhatsApp.",
    ]}
  />

  <!-- Main Content Body -->
  <section class="py-8 mx-auto max-w-4xl px-4 sm:px-6">
    <div class="prose prose-lg dark:prose-invert mx-auto">
      <!-- Copywriting Problem & Solution -->
      <h2 class="text-2xl font-bold mb-4 text-foreground">
        Berhenti Kehilangan Pelanggan Akibat Website Lambat
      </h2>
      <p class="text-[14px] text-muted-foreground leading-relaxed mb-8">
        Tahukah Anda? Lebih dari 53% pengunjung akan langsung menutup halaman
        jika website memuat lebih dari 3 detik. Desain yang indah tidak ada
        artinya jika calon pembeli sudah kabur sebelum melihat penawaran Anda.
        Kami membangun website menggunakan teknologi *Static Site Generator*
        (Astro) yang menjamin *loading* instan dan navigasi super ringan,
        terutama dari layar ponsel.
      </p>

      <h2 class="text-2xl font-bold mb-6 text-foreground">
        Spesifikasi Website Berperforma Tinggi Netmediatop
      </h2>

      <!-- GAMBAR 1 (Di Tengah) -->
      <figure class="my-8 max-w-md mx-auto not-prose">
        <Image
          src={imgWebDev}
          alt="Performa Kecepatan Web & Core Web Vitals"
          class="w-full h-auto rounded-xl border border-border shadow-sm object-cover"
        />
        <figcaption
          class="text-center text-[12px] text-muted-foreground mt-2 italic"
        >
          Skor hijau Core Web Vitals untuk kecepatan maksimal.
        </figcaption>
      </figure>

      <!-- KONTEN POIN 1 & 2 -->
      <div class="space-y-4 my-8 not-prose">
        <div class="p-4 border border-border rounded-xl bg-card">
          <span
            class="inline-block px-2.5 py-0.5 text-[11px] font-bold uppercase rounded-full bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200 mb-1.5"
          >
            1. Kecepatan Loading Instan
          </span>
          <h3 class="text-base font-semibold text-foreground mb-1">
            Anti-Lemot, Anti-Mental
          </h3>
          <p class="text-[14px] text-muted-foreground leading-relaxed">
            Infrastruktur kode bersih tanpa plugin berat. Memastikan halaman
            Anda terbuka seketika, menurunkan angka pentalan (*bounce rate*),
            dan sangat disukai algoritma SEO Google.
          </p>
        </div>

        <div class="p-4 border border-border rounded-xl bg-card">
          <span
            class="inline-block px-2.5 py-0.5 text-[11px] font-bold uppercase rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 mb-1.5"
          >
            2. Tampilan 100% Responsif HP
          </span>
          <h3 class="text-base font-semibold text-foreground mb-1">
            Fokus pada Pengguna Mobile
          </h3>
          <p class="text-[14px] text-muted-foreground leading-relaxed">
            Karena 80% calon pembeli menggunakan *smartphone*, kami merancang
            UI/UX (*User Interface/User Experience*) yang proporsional, rapi,
            dan mudah diklik oleh jempol.
          </p>
        </div>
      </div>

      <!-- GAMBAR 2 (Di Tengah) -->
      <figure class="my-8 max-w-md mx-auto not-prose">
        <Image
          src={imgDevBalanced}
          alt="Desain UI/UX & Alur Konversi Web"
          class="w-full h-auto rounded-xl border border-border shadow-sm object-cover"
        />
        <figcaption
          class="text-center text-[12px] text-muted-foreground mt-2 italic"
        >
          Integrasi desain responsif & navigasi klik ke chat WA.
        </figcaption>
      </figure>

      <!-- KONTEN POIN 3 -->
      <div class="space-y-4 my-8 not-prose">
        <div
          class="p-5 border border-border rounded-xl bg-card border-l-4 border-l-green-600"
        >
          <span
            class="inline-block px-2.5 py-0.5 text-[11px] font-bold uppercase rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 mb-2"
          >
            3. Alur Konversi Menuju WhatsApp
          </span>
          <h3 class="text-lg font-semibold text-foreground mb-2">
            Satu Klik Menuju Transaksi
          </h3>
          <p class="text-[14px] text-muted-foreground leading-relaxed">
            Penempatan tombol *Call-to-Action* (CTA) WhatsApp yang strategis,
            persisten (*floating button*), dan *copywriting* penawaran yang
            mendesak pengunjung agar segera berkonsultasi langsung ke nomor
            Anda.
          </p>
        </div>
      </div>

      <!-- SILO CLUSTER SECTION (Navigasi Internal Link ke Sub-Topik Web Dev) -->
      <div class="my-10 p-6 border-l-4 border-primary bg-muted/30 rounded-r-xl">
        <h3 class="text-xl font-bold mb-3 text-foreground">
          Eksplorasi Klaster Layanan & Tipe Web Kami:
        </h3>
        <p class="text-[14px] text-muted-foreground mb-4">
          Sesuaikan infrastruktur website Anda berdasarkan tujuan utama
          pemasaran digital Anda:
        </p>

        <ul class="space-y-3 text-base font-medium">
          <li>
            👉 <a
              href="/services/web/landing-page"
              class="text-primary underline hover:text-primary/80 transition-colors"
            >
              Jasa Pembuatan Landing Page High-Conversion
            </a>
            <span
              class="text-[13px] text-muted-foreground font-normal block md:inline"
            >
              (Halaman penawaran tajam, dirancang khusus untuk memanen klik dari
              iklan)</span
            >
          </li>
          <li>
            👉 <a
              href="/services/web/company-profile"
              class="text-primary underline hover:text-primary/80 transition-colors"
            >
              Pembuatan Web Company Profile & Katalog Usaha
            </a>
            <span
              class="text-[13px] text-muted-foreground font-normal block md:inline"
            >
              (Etalase digital profesional untuk meningkatkan kredibilitas brand
              & mitra bisnis)</span
            >
          </li>
          <li>
            👉 <a
              href="/services/web/speed-optimization"
              class="text-primary underline hover:text-primary/80 transition-colors"
            >
              Layanan Optimasi Kecepatan Web (Core Web Vitals)
            </a>
            <span
              class="text-[13px] text-muted-foreground font-normal block md:inline"
            >
              (Perombakan kode pada web lama Anda agar menjadi secepat kilat)</span
            >
          </li>
          <li>
            👉 <a
              href="/services/web/pseo-architecture"
              class="text-primary underline hover:text-primary/80 transition-colors"
            >
              Sistem Web Programmatic SEO (pSEO)
            </a>
            <span
              class="text-[13px] text-muted-foreground font-normal block md:inline"
            >
              (Struktur web canggih yang mampu menghasilkan ribuan halaman
              lokasi otomatis)</span
            >
          </li>
        </ul>
      </div>

      <!-- Fitur & Alur Pengelolaan -->
      <h2 class="text-2xl font-bold mb-4 text-foreground">
        Standar Kualitas Infrastruktur Web Netmediatop
      </h2>
      <ul
        class="list-disc pl-6 space-y-2 text-muted-foreground mb-8 text-[14px]"
      >
        <li>
          Dibangun di atas framework modern (Astro / Tailwind) untuk jaminan
          performa maksimal.
        </li>
        <li>
          Bebas risiko diretas atau rentan malware karena tidak menggunakan
          sistem database lawas.
        </li>
        <li>
          Kode sudah disematkan Schema Markup & Metadata yang 100% SEO-ready
          dari awal.
        </li>
        <li>
          Integrasi Meta Pixel dan Google Tag Manager untuk kebutuhan pelacakan
          iklan.
        </li>
        <li>
          Gratis sertifikat keamanan (SSL) dan hosting tangguh berbasis jaringan
          CDN global.
        </li>
      </ul>

      <!-- Cross-Silo Link ke Service Pilar Lain -->
      <div
        class="p-4 border border-border rounded-lg bg-card text-[14px] text-muted-foreground my-8"
      >
        💡 <strong>Catatan Strategi:</strong> Website canggih Anda akan menjadi investasi
        bisnis yang lebih menguntungkan jika diisi dengan trafik dari optimasi <a
          href="/services/seo-optimization"
          class="text-primary underline font-semibold">SEO Organik</a
        >, atau didongkrak penyebarannya menggunakan iklan <a
          href="/services/google-ads"
          class="text-primary underline font-semibold">Google Ads Presisi</a
        >.
      </div>

      <!-- CTA Box Ke WhatsApp -->
      <div
        class="mt-12 p-8 border border-primary/20 rounded-2xl bg-primary/5 text-center"
      >
        <h3 class="text-xl font-bold mb-2 text-foreground">
          Siap Bangun Website Berkecepatan Tinggi untuk Bisnis Anda?
        </h3>
        <p class="text-[14px] text-muted-foreground mb-6 max-w-lg mx-auto">
          Konsultasikan kebutuhan fitur, desain, dan target audiens usaha Anda
          bersama tim developer kami.
        </p>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg shadow-md transition-colors gap-2"
        >
          <span>Diskusi Pembuatan Web via WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
