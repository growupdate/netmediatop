---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceList from "@/components/widgets/ServiceList.astro";
import Content from "@/components/widgets/Content.astro";

const services = [
  {
    title: "Web Development",
    description:
      "Teknologi terbaru, responsive di semua gadget, pagespeed 90+, aman, dan dirancang khusus untuk konversi.",
    icon: "lucide:globe",
    href: "/services/jasa-pembuatan-website",
  },
  {
    title: "SEO Optimization",
    description:
      "Teknik SEO, AEO, & GEO modern agar usaha Anda mudah ditemukan calon pembeli secara organik di Google.",
    icon: "lucide:search",
    href: "/services/jasa-seo",
  },
  {
    title: "Google Ads",
    description:
      "Iklan terarah menjangkau orang yang sedang aktif mencari produk Anda untuk hasil pencarian instan.",
    icon: "lucide:target",
    href: "/services/jasa-iklan-google-ads",
  },
  {
    title: "Meta Ads",
    description:
      "Jangkau target audiens spesifik di Instagram & Facebook dengan alur pesan langsung ke WhatsApp.",
    icon: "lucide:megaphone",
    href: "/services/jasa-iklan-facebook",
  },
  {
    title: "Konten Strategis",
    description:
      "Penyusunan alur penawaran dan pesan edukatif yang persuasif untuk meningkatkan rasa percaya calon pembeli.",
    icon: "lucide:file-text",
    href: "/services/penulis-konten",
  },
  {
    title: "Sosmed Konten Manajemen",
    description:
      "Pengelolaan tampilan media sosial secara rapi dan konsisten tanpa mengganggu fokus operasional Anda.",
    icon: "lucide:share-2",
    href: "/services/jasa-konten-sosmed",
  },
];

const metadata = {
  title: "Layanan Kami",
  description:
    "Layanan pemasaran digital terpadu, jasa pembuatan website, jasa seo, jasa iklan google ads, jasa iklan facebook, penulis artikel/konten, jasa konten sosmed. Semuanya untuk bantu bisnis  Anda tampil profesional dan mendominasi pasar digital.",
};
---

<BaseLayout {metadata}>
  <Content
    tagline="Layanan Kami"
    title="Solusi Digital untuk Tumbuh Kembang Usaha Anda"
    description={[
      "Pilih layanan digital marketing yang Anda butuhkan sesuai kebutuhan bisnis agar tumbuh dan berkembang.",
    ]}
  />
  <ServiceList services={services} classes={{ container: "pt-0 md:pt-0" }} />
</BaseLayout>
