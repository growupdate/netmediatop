---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Features from "@/components/widgets/Features.astro";
import Content from "@/components/widgets/Content.astro";
import Form from "@/components/ui/Form.astro";

const metadata = {
  title: "Kontak & Konsultasi Strategi Digital - Netmediatop",
  description:
    "Diskusikan proyek digital marketing, pembuatan website, atau optimasi SEO bisnis Anda bersama tim ahli Netmediatop. Respon cepat via WhatsApp.",
};

const visionText = [
  "Mari diskusikan rencana pertumbuhan bisnis Anda bersama tim Netmediatop. Dapatkan solusi digital marketing yang terarah, transparan, dan berorientasi pada profit nyata.",
];
---

<BaseLayout {metadata}>
  <Content
    tagline="Hubungi Kami"
    title="Wujudkan Pertumbuhan Bisnis Anda Sekarang"
    description={visionText}
  />

  <!-- Form Kotak Kontak Utama -->
  <div
    class="reveal mx-auto max-w-xl bg-card border border-border rounded-3xl p-8 shadow-sm mb-12 md:mb-16"
  >
    <div class="mb-6 text-center">
      <h3 class="text-xl font-bold text-foreground mb-1">Kirim Pesan Cepat</h3>
      <p class="text-[14px] text-muted-foreground">
        Isi formulir di bawah ini dan tim kami akan segera menghubungi Anda.
      </p>
    </div>
    <Form />
  </div>

  <!-- Saluran Komunikasi Alternatif -->
  <Features
    tagline="Saluran Komunikasi"
    title="Pilih Cara Tercepat Menghubungi Kami"
    subtitle="Kami siap merespons kebutuhan konsultasi bisnis Anda dalam waktu kurang dari 24 jam."
    classes={{ container: "pt-0 md:pt-0" }}
    features={[
      {
        title: "WhatsApp Bisnis",
        description: "0823 2918 8998 (Respon Paling Cepat)",
        icon: "lucide:phone",
        iconClass: "bg-green-500/10 text-green-500",
      },
      {
        title: "Email Resmi",
        description: "contact@netmediatop.com",
        icon: "lucide:mail",
        iconClass: "bg-yellow-500/10 text-yellow-500",
      },
      {
        title: "Lokasi Kantor",
        description:
          "Jl Kramat Kecil 04/03 Barongan Kudus, Jawa Tengah, Indonesia",
        icon: "lucide:map-pin",
        iconClass: "bg-red-500/10 text-red-500",
      },
      {
        title: "Konsultasi Personal",
        description:
          "Analisis kebutuhan spesifik yang disesuaikan dengan skala bisnis Anda.",
        icon: "lucide:user-check",
        iconClass: "bg-blue-500/10 text-blue-500",
      },
      {
        title: "Dukungan Teknis",
        description:
          "Bantuan penanganan kendala website & performa iklan secara sigap.",
        icon: "lucide:wrench",
        iconClass: "bg-purple-500/10 text-purple-500",
      },
      {
        title: "Konsultasi Strategi",
        description:
          "Rancang blueprint pemasaran digital bersama digital strategist berpengalaman.",
        icon: "lucide:briefcase",
        iconClass: "bg-pink-500/10 text-pink-500",
      },
    ]}
  />
</BaseLayout>
