---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import devImg from "@/assets/images/dev_balanced.png";
import openSourceImg from "@/assets/images/internet-marketing.jpeg";
import Content2 from "@/components/widgets/Content2.astro";
const metadata = {
  title: `${siteConfig.name} — next step for your project`,
  description: "Bantu Bisnis Online Berkembang Lebih Cepat dan Menguntungkan",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`Bisnis Anda Makin Sepi? <br class="hidden md:block" /> <span class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent"><br>Ingin Online dan Berkembang </span>`}
    tagline="Netmediatop-Digital Marketing Pro"
    description={`${siteConfig.description}`}
    actions={[
      {
        text: "Kontak Kami",
        href: "https://wa.me/6282329188998?text=Halo%20Netmediatop%2C%20saya%20ingin%20bertanya.",
        variant: "primary",
        icon: "lucide:message-circle",
      },
      {
        text: "Our Services",
        href: "/services",
        variant: "secondary",
        icon: "lucide:arrow-right",
        ariaLabel: "Lebih Detail Layanan Kami",
      },
    ]}
  />

  <Content2
    items={[
      {
        title: "Bisnis Tidak Ditemukan Online ",
        description:
          "Produk Anda  bagus, tapi calon pelanggan tidak bisa menemukan Anda di Google. Anda perlu muncul saat mereka mencari.",
        icon: "lucide:scan-search",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: " Sudah Online Tapi Zonk",
        description:
          " Punya website, sosmed tapi sepi pengunjung atau lihat lalu pergi tidak ada kontak.",
        icon: "lucide:zap",
        iconClass: "bg-yellow-500/10 text-purple-400",
      },
      {
        title: "Tidak Tahu Mulai Dari Mana? ",
        description:
          "Tidak ada waktu urus digital yang terpisah-pisah. Kami berikan satu sistem yang terarah, terukur, agar bisnis Anda tumbuh",
        icon: "lucide:palette",
        iconClass: "bg-green-500/10 text-yellow-400",
      },
    ]}
    image={devImg}
    imageAlt="Development"
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Let’s Grow Your Business Through Digital Marketing
      </h3>
      We provide a solid foundation to start your projects with best practices.
    </Fragment>
  </Content2>
  <Features
    tagline="netmediatop"
    title=" bantu agar bisnis Anda mudah ditemukan pembeli"
    subtitle="lewat sistem total digital marketing terukur dan terarah sesuai bisnis"
    features={[
      {
        title: "Website Development",
        description:
          "Website Membuat bisnis Anda terlihat profesional dan mengubah pengunjung menjadi calon pelanggan..",
        icon: "lucide:scan-search",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Seo High Performance",
        description:
          "Membantu bisnis Anda lebih mudah ditemukan saat calon pelanggan mencari produk atau jasa yang Anda tawarkan.",
        icon: "lucide:zap",
        iconClass: "bg-purple-500/10 text-purple-400",
      },
      {
        title: "Konten Berkualitas ",
        description:
          "Membangun kepercayaan, menjawab kebutuhan calon pelanggan, dan membantu website mendapatkan lebih banyak pengunjung dari pencarian.",
        icon: "lucide:palette",
        iconClass: "bg-pink-500/10 text-green-400",
      },
      {
        title: "Sosial Media Marketing",
        description:
          "Meningkatkan jangkauan bisnis, membangun kepercayaan, dan menjaga hubungan dengan calon pelanggan.",
        icon: "lucide:palette",
        iconClass: "bg-pink-500/10 text-white-400",
      },
      {
        title: "AI Marketing System",
        description:
          "Kami implementasikan AI khusus untuk bisnis Anda - untuk otomatisasi chat, analisa data pelanggan, dan pembuatan konten. Agar kerja lebih cepat, lebih hemat, dan 100% terukur.",
        icon: "lucide:palette",
        iconClass: "bg-pink-500/10 text-blue-400",
      },
    ]}
  />

  <Content2
    items={[]}
    image={openSourceImg}
    imageAlt="jasa digital marketing"
    isReversed={true}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Bisnis Butuh Keputusan Tepat
      </h3>
      Saatnya transformasi digital yang menghasilkan. Dapatkan audit sistem gratis
      dari Netmediatop, kami rancang fondasi website, SEO, dan konten terarah agar
      bisnis tumbuh terukur dan dominan di pasar Anda sekarang juga.
    </Fragment>
  </Content2>
</BaseLayout>
