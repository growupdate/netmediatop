---
import BaseLayout from "@/layouts/BaseLayout.astro";
import aboutOffice from "@/assets/images/about-office.webp";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const metadata = {
  title: "Digital Marketing untuk Bisnis yang Ingin Tumbuh | NetMediaTop",
  description:
    "Pemasaran digital terarah melalui website, SEO, Google Ads, dan content marketing.",
  ignoreTitleTemplate: true,
};
const wa =
  "https://wa.me/6282329188998?text=Halo%20NetMediaTop%2C%20saya%20ingin%20konsultasi.";
const problems = [
  [
    "Website Ada, tetapi Pelanggan Tidak Datang",
    "Website kurang meyakinkan atau pengunjung tidak tahu harus menghubungi ke mana.",
    "Bangun website profesional yang mudah dipahami dan memudahkan pengunjung menghubungi bisnis.",
    "/services/jasa-pembuatan-website",
    "Jelajahi Jasa Pembuatan Website",
  ],
  [
    "Bisnis Sulit Ditemukan Calon Pelanggan",
    "Orang mencari produk atau jasa di Google, tetapi kompetitor lebih mudah ditemukan.",
    "Tingkatkan visibilitas melalui SEO, konten relevan, dan optimasi Google Business Profile.",
    "/services/jasa-seo",
    "Pelajari Layanan SEO",
  ],
  [
    "Iklan Berjalan, tetapi Hasil Belum Maksimal",
    "Anggaran sudah dikeluarkan, tetapi belum jelas apakah iklan mendatangkan pelanggan tepat.",
    "Rencanakan Google dan Meta Ads berdasarkan target, penawaran, dan tujuan terukur.",
    "/services/jasa-iklan-google-ads",
    "Pelajari Digital Advertising",
  ],
  [
    "Konten Ramai, tetapi Belum Menghasilkan Pelanggan",
    "Konten rutin dibuat, tetapi belum cukup membantu calon pelanggan memahami dan mempercayai bisnis.",
    "Bangun content marketing yang menjawab kebutuhan pelanggan.",
    "/services/jasa-konten-sosmed",
    "Pelajari Content Marketing",
  ],
];
const packages: [string, string, string, string[], string, string][] = [
  [
    "LOCAL START",
    "Bangun Fondasi Digital Bisnis Anda.",
    "Untuk bisnis yang ingin mulai hadir online dan ditemukan di Google.",
    [
      "Website bisnis",
      "SEO dasar dan halaman layanan",
      "Google Business Profile",
      "Riset kata kunci lokal",
      "Pengukuran inquiry",
    ],
    "Fondasi digital profesional dan peluang ditemukan lewat pencarian lokal.",
    "/paket-digital-marketing/local-start/",
  ],
  [
    "BUSINESS GROWTH",
    "Perluas Jangkauan dan Peluang Pelanggan.",
    "Untuk bisnis yang ingin berkembang melalui Google, website, dan media sosial.",
    [
      "Website atau landing page",
      "SEO dan pengembangan konten",
      "Google Ads",
      "Konten media sosial",
      "Pengukuran kampanye",
    ],
    "Jangkauan lebih luas dari beberapa saluran digital.",
    "/paket-digital-marketing/business-growth/",
  ],
  [
    "INTEGRATED GROWTH",
    "Satukan Pemasaran Digital dalam Satu Strategi.",
    "Untuk bisnis yang ingin pemasaran menyeluruh dan terintegrasi.",
    [
      "Optimasi website",
      "SEO dan content marketing",
      "Google Ads dan Meta Ads",
      "Konten media sosial",
      "Retargeting dan evaluasi",
    ],
    "Pemasaran terukur yang dapat dikembangkan mengikuti kebutuhan.",
    "/paket-digital-marketing/integrated-growth/",
  ],
];
const benefits = [
  [
    "Lebih Mudah Ditemukan",
    "Membuka peluang bisnis ditemukan orang yang mencari produk atau jasa Anda.",
  ],
  [
    "Meningkatkan Kepercayaan",
    "Tampilkan bisnis secara profesional dengan website dan informasi jelas.",
  ],
  [
    "Menjangkau Calon Pelanggan",
    "Gunakan Google, iklan, dan media sosial untuk menjangkau target pasar.",
  ],
  [
    "Pemasaran Lebih Terarah",
    "Tetapkan tujuan, anggaran, dan pengukuran untuk aktivitas pemasaran.",
  ],
];
const reasons = [
  [
    "Tidak Sekadar Menawarkan Jasa",
    "Kami memahami masalah bisnis sebelum merekomendasikan layanan.",
  ],
  [
    "Solusi Sesuai Kebutuhan",
    "Prioritas disesuaikan dengan kondisi bisnis dan anggaran.",
  ],
  [
    "Layanan Saling Mendukung",
    "Website, SEO, iklan, dan konten dilihat sebagai satu rangkaian.",
  ],
  [
    "Fokus pada Perkembangan",
    "Perhatikan tujuan pekerjaan dan perkembangan yang dapat diukur.",
  ],
];
const faqs = [
  [
    "Bisnis kecil atau UMKM bisa menggunakan layanan?",
    "Tentu. Solusi disesuaikan dengan kebutuhan, kondisi, dan kemampuan bisnis.",
  ],
  [
    "Belum punya website, bisa dibantu dari awal?",
    "Bisa, mulai dari perencanaan hingga pembuatan website dan informasi bisnis.",
  ],
  [
    "Harus menggunakan semua layanan sekaligus?",
    "Tidak. Anda dapat memulai dari satu layanan dan mengembangkan strategi bertahap.",
  ],
  [
    "Berapa biayanya?",
    "Harga paket di bawah masih placeholder untuk review. Biaya final bergantung kebutuhan dan lingkup pekerjaan.",
  ],
  [
    "Apakah SEO dan iklan langsung menghasilkan pelanggan?",
    "Tidak ada jaminan instan. Iklan perlu evaluasi, sedangkan SEO memerlukan proses.",
  ],
  [
    "Bagaimana memulai kerja sama?",
    "Hubungi kami, ceritakan kondisi bisnis dan target. Kita diskusikan langkah yang sesuai.",
  ],
];
---

<BaseLayout {metadata}>
  <main class="overflow-hidden">
    <!-- 01 HERO -->
    <section class="py-16 sm:py-24">
      <div
        class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2"
      >
        <div>
          <p
            class="mb-4 text-sm font-bold uppercase tracking-widest text-blue-600 dark:text-white"
          >
            Partner Digital Marketing untuk Bisnis
          </p><h1
            class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl"
          >
            Bisnis Sulit Berkembang? Saatnya Perbaiki Cara Anda Mendapatkan
            Pelanggan.
          </h1><p
            class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300"
          >
            Sudah punya produk bagus, tetapi pelanggan belum bertambah? Website
            belum menghasilkan inquiry, bisnis sulit ditemukan di Google, atau
            biaya iklan terus berjalan tanpa hasil yang jelas?
          </p><p class="mt-4 text-slate-600 dark:text-slate-300">
            NetMediaTop membantu bisnis membangun pemasaran digital terarah
            melalui website, SEO, Google Ads, dan content marketing agar lebih
            mudah ditemukan, dipercaya, dan dipilih pelanggan.
          </p><div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={wa}
              class="rounded-xl bg-blue-600 px-6 py-3.5 text-center font-bold text-white"
              >Konsultasikan Bisnis Anda</a
            ><a
              href="#solusi"
              class="rounded-xl border px-6 py-3.5 text-center font-semibold"
              >Kenali Solusi Kami</a
            >
          </div>
        </div><div class="rounded-3xl border p-3 shadow-xl">
          <img
            src={aboutOffice.src}
            alt="Ruang kerja NetMediaTop sebagai referensi visual hero"
            class="aspect-[4/3] w-full rounded-2xl object-cover"
            fetchpriority="high"
          /><div
            class="grid grid-cols-3 gap-2 p-3 text-center text-xs font-semibold"
          >
            <span>Website</span><span>Google & SEO</span><span
              >Konten & Ads</span
            >
          </div>
        </div>
      </div>
    </section>
    <!-- 02 PROBLEM / SOLUTION -->
    <section id="solusi" class="bg-slate-50 py-16 dark:bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Masalah dan Solusi
          </p><h2 class="mt-3 text-3xl font-bold">
            Banyak Bisnis Sudah Melakukan Pemasaran Online, Tetapi Belum
            Mendapatkan Hasil yang Diharapkan.
          </h2><p class="mt-4 text-slate-600 dark:text-slate-300">
            Website, iklan, atau media sosial adalah langkah baik. Namun, jika
            berjalan sendiri-sendiri tanpa arah, pemasaran bisa menghabiskan
            waktu dan biaya. Kami membantu menghubungkan aktivitas digital untuk
            tujuan bisnis yang sama.
          </p>
        </header><div class="grid gap-5 md:grid-cols-2">
          {
            problems.map((p, i) => (
              <article class="flex flex-col rounded-2xl border bg-white p-6 dark:bg-slate-900">
                <>
                  <span class="text-sm font-bold text-blue-600 dark:text-white">
                    0{i + 1} / TANTANGAN
                  </span>
                  <h3 class="mt-3 text-xl font-bold">{p[0]}</h3>
                  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
                    {p[1]}
                  </p>
                  <p class="mt-4 text-sm">
                    <b>Solusi:</b> {p[2]}
                  </p>
                  <a
                    href={p[3]}
                    class="mt-auto pt-5 font-semibold text-blue-600 dark:text-white"
                  >
                    {p[4]} →
                  </a>
                </>
              </article>
            ))
          }
        </div><p class="mx-auto mt-8 max-w-3xl text-center">
          Masalahnya mungkin bukan bisnis Anda kurang bagus. Calon pelanggan
          bisa jadi belum menemukan, memahami, atau cukup yakin memilih Anda. <a
            href="/services"
            class="font-bold text-blue-600 dark:text-white"
            >Lihat semua layanan →</a
          >
        </p>
      </div>
    </section>
    <!-- 03 PACKAGES -->
    <section id="paket-digital-marketing" class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Pilihan Paket
          </p><h2 class="mt-3 text-3xl font-bold">
            Satu Tujuan, Tiga Pilihan Strategi untuk Mengembangkan Bisnis Anda.
          </h2><p class="mt-4 text-slate-600 dark:text-slate-300">
            Setiap bisnis punya cara berbeda mendapat pelanggan. Pilih paket
            sesuai kondisi dan tujuan bisnis.
          </p>
        </header><div class="grid gap-5 lg:grid-cols-3">
          {
            packages.map((p) => (
              <article class="flex flex-col rounded-2xl border bg-white p-6 shadow-sm dark:bg-slate-900">
                <>
                  <p class="text-xs font-extrabold tracking-widest text-blue-600 dark:text-white">
                    {p[0]}
                  </p>
                  <h3 class="mt-3 text-xl font-bold">{p[1]}</h3>
                  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
                    {p[2]}
                  </p>
                  <div class="my-5 rounded-xl bg-slate-50 p-4 dark:bg-slate-800">
                    <>
                      <small>Harga contoh untuk review · belum final</small>
                      <p class="text-2xl font-extrabold">Rp X.XXX.XXX</p>
                      <small>/ bulan · placeholder</small>
                    </>
                  </div>
                  <b class="text-sm">Solusi yang termasuk:</b>
                  <ul class="mt-2 space-y-2 text-sm">
                    {p[3].map((v) => (
                      <li>✓ {v}</li>
                    ))}
                  </ul>
                  <p class="mt-4 text-sm">
                    <b>Hasil yang dituju:</b> {p[4]}
                  </p>
                  <a
                    href={p[5]}
                    class="mt-auto pt-6 font-bold text-blue-600 dark:text-white"
                  >
                    Pelajari Paket {p[0]} →
                  </a>
                </>
              </article>
            ))
          }
        </div><p
          class="mt-6 rounded-xl border border-dashed border-amber-400 bg-amber-50 p-4 text-sm dark:bg-amber-950/30"
        >
          <b>Catatan review:</b> harga, durasi, kuota pekerjaan, biaya iklan, dan
          batas revisi perlu ditentukan. Biaya media iklan sebaiknya dipisahkan dari
          jasa pengelolaan.
        </p><div class="mt-8 text-center">
          <b>Belum yakin paket mana yang sesuai?</b><p class="mt-2">
            Ceritakan kondisi bisnis dan anggaran. Kami bantu menentukan
            kombinasi layanan yang masuk akal.
          </p><a
            href={wa}
            class="mt-4 inline-flex rounded-xl bg-blue-600 px-5 py-3 font-bold text-white"
            >Konsultasikan Paket Anda</a
          ><br /><a
            href="/services"
            class="mt-3 inline-flex text-blue-600 dark:text-white"
            >Lihat layanan →</a
          >
        </div>
      </div>
    </section>
    <!-- 04 BENEFITS -->
    <section class="bg-slate-50 py-16 dark:bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Manfaat
          </p><h2 class="mt-3 text-3xl font-bold">
            Pemasaran Digital yang Tepat Membantu Bisnis Bergerak Lebih Maju.
          </h2><p class="mt-4">
            Website, Google, konten, dan iklan yang terencana membuka peluang
            lebih besar menjangkau pelanggan.
          </p>
        </header><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            benefits.map(([t, d]) => (
              <article class="rounded-2xl border bg-white p-6 dark:bg-slate-900">
                <>
                  <span class="text-2xl text-blue-600 dark:text-white">✦</span>
                  <h3 class="mt-4 font-bold">{t}</h3>
                  <p class="mt-2 text-sm">{d}</p>
                </>
              </article>
            ))
          }
        </div><p class="mt-8 text-center">
          <a
            href="#paket-digital-marketing"
            class="font-bold text-blue-600 dark:text-white">Lihat paket →</a
          >
        </p>
      </div>
    </section>
    <!-- 05 TRUST -->
    <section class="py-16">
      <div
        class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
      >
        <div>
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Mengapa NetMediaTop
          </p><h2 class="mt-3 text-3xl font-bold">
            Partner Digital Marketing yang Memahami Kebutuhan Bisnis Anda.
          </h2><p class="mt-4">
            Anda membutuhkan partner yang memahami usaha, menjelaskan pilihan,
            dan menjalankan strategi sesuai kebutuhan.
          </p><div class="mt-7 grid gap-5 sm:grid-cols-2">
            {
              reasons.map(([t, d]) => (
                <article>
                  <>
                    <h3 class="font-bold">{t}</h3>
                    <p class="mt-1 text-sm">{d}</p>
                  </>
                </article>
              ))
            }
          </div><a
            href="/about"
            class="mt-7 inline-flex font-bold text-blue-600 dark:text-white"
            >Kenali NetMediaTop Lebih Dekat →</a
          >
        </div><figure>
          <img
            src={aboutOffice.src}
            alt="Ruang kerja NetMediaTop"
            class="aspect-[4/3] w-full rounded-3xl object-cover"
            loading="lazy"
          /><figcaption class="text-xs text-slate-500">
            Foto kantor · about-office.webp
          </figcaption>
        </figure>
      </div>
    </section>
    <!-- 06 PORTFOLIO -->
    <section class="bg-slate-50 py-16 dark:bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Portfolio · Placeholder
          </p><h2 class="mt-3 text-3xl font-bold">
            Beberapa Pekerjaan yang Telah Kami Kerjakan.
          </h2><p class="mt-4">
            Nama proyek dan gambar di bawah adalah placeholder Lorem Ipsum untuk
            review, bukan klaim proyek nyata.
          </p>
        </header><div class="grid gap-5 md:grid-cols-3">
          {
            [
              "Website Company Profile",
              "Landing Page Bisnis Lokal",
              "SEO & Content Development",
            ].map((t, i) => (
              <article class="overflow-hidden rounded-2xl border bg-white dark:bg-slate-900">
                <>
                  <div class="flex aspect-[4/3] items-center justify-center bg-gradient-to-br from-blue-100 to-purple-100 text-3xl font-extrabold dark:from-blue-950 dark:to-purple-950">
                    Lorem Ipsum {i + 1}
                  </div>
                  <div class="p-5">
                    <>
                      <h3 class="font-bold">{t}</h3>
                      <p class="mt-1 text-xs">
                        Lorem Ipsum Dolor · Contoh Jenis Usaha
                      </p>
                      <p class="mt-3 text-sm">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                        Contoh layout portfolio.
                      </p>
                      <a
                        href="/studi-kasus"
                        class="mt-4 inline-flex text-blue-600 dark:text-white"
                      >
                        Lihat studi kasus →
                      </a>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div><p class="mt-8 text-center">
          <a href="/studi-kasus" class="font-bold text-blue-600 dark:text-white"
            >Lihat semua portfolio →</a
          >
        </p>
      </div>
    </section>
    <!-- 07 TESTIMONIAL -->
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Pengalaman Pelanggan
          </p><h2 class="mt-3 text-3xl font-bold">
            Apa Kata Mereka tentang Pengalaman Bekerja Bersama Kami?
          </h2><p class="mt-4">
            Kenali cara kerja dan layanan kami dari pengalaman pelanggan.
          </p>
        </header><div class="grid gap-5 md:grid-cols-2">
          {
            [1, 2].map((n) => (
              <blockquote class="rounded-2xl border border-dashed bg-slate-50 p-6 dark:bg-slate-900">
                <>
                  <b class="text-xs text-amber-700">
                    PLACEHOLDER · TESTIMONI ASLI
                  </b>
                  <p class="mt-5 text-lg">
                    “Lorem ipsum dolor sit amet. Masukkan testimoni asli tentang
                    proses, komunikasi, atau hasil.”
                  </p>
                  <footer class="mt-5 text-sm font-semibold">
                    Nama Pelanggan {n} · Nama Bisnis
                  </footer>
                </>
              </blockquote>
            ))
          }
        </div><p class="mt-4 text-center text-xs">
          Contoh layout, bukan testimoni sungguhan.
        </p><p class="mt-6 text-center">
          <a href="/services" class="font-bold text-blue-600 dark:text-white"
            >Lihat layanan →</a
          >
        </p>
      </div>
    </section>
    <!-- 08 FAQ -->
    <section class="bg-slate-50 py-16 dark:bg-slate-900/40">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <header class="mb-10 text-center">
          <p class="text-sm font-bold uppercase text-blue-600 dark:text-white">
            Pertanyaan Umum
          </p><h2 class="mt-3 text-3xl font-bold">
            Pertanyaan Sebelum Memulai Kerja Sama dengan NetMediaTop.
          </h2>
        </header><div class="space-y-3">
          {
            faqs.map(([q, a]) => (
              <details class="rounded-xl border bg-white p-5 dark:bg-slate-900">
                <>
                  <summary class="cursor-pointer font-bold">{q}</summary>
                  <p class="mt-3 text-sm">{a}</p>
                </>
              </details>
            ))
          }
        </div><p class="mt-6 text-center">
          <a href="/services" class="font-bold text-blue-600 dark:text-white"
            >Lihat layanan NetMediaTop →</a
          >
        </p>
      </div>
    </section>
    <!-- 09 ARTIKEL TERBARU -->
    <section class="bg-slate-50 py-16 dark:bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <header
          class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <p class="text-sm font-bold uppercase text-white">Blog & Wawasan</p>
            <h2 class="mt-3 text-3xl font-bold">
              Artikel Terbaru untuk Mengembangkan Bisnis
            </h2>
          </div>
          <a href="/blog" class="font-semibold text-white"
            >Lihat semua artikel →</a
          >
        </header>
        <div class="grid gap-5 md:grid-cols-3">
          {
            latestPosts.map((post) => (
              <article class="flex flex-col overflow-hidden rounded-2xl border bg-white dark:bg-slate-900">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="aspect-video w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-xs font-semibold uppercase tracking-wide text-white">
                    {post.data.category || "Artikel"}
                  </p>
                  <h3 class="mt-3 text-xl font-bold leading-snug">
                    <a class="hover:text-white" href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                    {post.data.description}
                  </p>
                  <a
                    class="mt-5 font-semibold text-white"
                    href={`/blog/${post.id}`}
                  >
                    Baca artikel →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <!-- 09 FINAL CTA -->
    <section
      id="konsultasi"
      class="bg-gradient-to-br from-blue-700 via-indigo-800 to-purple-900 py-16 text-white"
    >
      <div
        class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.2fr_.8fr]"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-blue-200">
            Jangan Biarkan Bisnis Anda Berjalan di Tempat
          </p><h2 class="mt-3 text-3xl font-extrabold">
            Jangan Tunggu Sampai Bisnis Semakin Sulit Mendapatkan Pelanggan.
          </h2><p class="mt-5 leading-relaxed text-blue-100">
            Persaingan terus berjalan dan calon pelanggan punya banyak pilihan.
            Saat penjualan melambat serta pemasaran tidak berkembang, menunda
            perbaikan bisa membuat bisnis tertinggal. Bisnis yang tidak
