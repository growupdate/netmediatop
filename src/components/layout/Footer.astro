import { siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();

// ID Channel YouTube Neil Patel (Resmi)
const YOUTUBE_CHANNEL_ID = "UCuAXFkgsw1L7xaCfnd5JJOw"; 
const RSS_URL = `https://www.youtube.com/feeds/videos.xml?channel_id=${YOUTUBE_CHANNEL_ID}`;

interface VideoItem {
  id: string;
  title: string;
  excerpt: string;
}

// Helper function untuk memotong deskripsi menjadi 10-15 kata
function truncateWords(text: string, count: number = 14): string {
  if (!text) return "Saksikan panduan SEO dan digital marketing terbukti langsung dari Neil Patel.";
  const cleanText = text
    .replace(/<[^>]*>/g, '')
    .replace(/["']/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  const words = cleanText.split(' ');
  if (words.length <= count) return cleanText;
  return words.slice(0, count).join(' ') + '...';
}

// Data Cadangan Murni Neil Patel (Tanpa ID Rickroll/Sisa Draf)
let latestVideos: VideoItem[] = [
  { 
    id: "A2G1nKk5_R0", 
    title: "How to Rank #1 on Google (Step by Step)", 
    excerpt: "Pelajari strategi SEO terbukti untuk mendominasi peringkat pertama Google secara organik dengan cepat." 
  },
  { 
    id: "1h8x1r6M92g", 
    title: "SEO Strategy for Beginners", 
    excerpt: "Panduan praktis riset kata kunci dan optimasi halaman web khusus untuk pemula." 
  },
  { 
    id: "k7x6u6V_g6M", 
    title: "Digital Marketing Trends for Growth", 
    excerpt: "Tips meningkatkan angka konversi penjualan dan pertumbuhan bisnis lokal secara efektif." 
  },
  { 
    id: "0jT_1MhV8YQ", 
    title: "Google Ads Tutorial Step-by-Step", 
    excerpt: "Cara merancang kampanye iklan Google Ads berkinerja tinggi dengan efisiensi anggaran maksimal." 
  },
];

// Pengambilan Data Otomatis via RSS Feed YouTube
try {
  const res = await fetch(RSS_URL);
  if (res.ok) {
    const xmlText = await res.text();
    const entries = xmlText.split('<entry>');
    
    if (entries.length > 1) {
      const parsed: VideoItem[] = [];
      for (let i = 1; i < entries.length && parsed.length < 5; i++) {
        const entry = entries[i];
        const idMatch = entry.match(/<yt:videoId>(.*?)<\/yt:videoId>/);
        const titleMatch = entry.match(/<title>(.*?)<\/title>/);
        const descMatch = entry.match(/<media:description>([\s\S]*?)<\/media:description>/);

        if (idMatch && titleMatch) {
          parsed.push({
            id: idMatch[1].trim(),
            title: titleMatch[1].trim(),
            excerpt: descMatch ? truncateWords(descMatch[1], 14) : "Saksikan panduan SEO dan digital marketing terbukti langsung dari Neil Patel.",
          });
        }
      }
      if (parsed.length > 0) {
        latestVideos = parsed;
      }
    }
  }
} catch (e) {
  console.error("Gagal mengambil RSS feed YouTube, beralih ke daftar video Neil Patel:", e);
}

