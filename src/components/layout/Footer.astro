<script>
  function initYtCarousel() {
    const track = document.getElementById('yt-carousel-track');
    const prevBtn = document.getElementById('yt-slide-prev');
    const nextBtn = document.getElementById('yt-slide-next');
    const counter = document.getElementById('yt-slide-counter');
    const titleEl = document.getElementById('yt-video-title');
    const excerptEl = document.getElementById('yt-video-excerpt');

    if (!track || !prevBtn || !nextBtn) return;

    const slides = Array.from(track.children);
    const totalSlides = slides.length;
    let currentIndex = 0;

    const titles = slides.map(s => s.getAttribute('data-title') || '');
    const excerpts = slides.map(s => s.getAttribute('data-excerpt') || '');

    function updateSlide() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      if (counter) {
        counter.textContent = `${currentIndex + 1}/${totalSlides}`;
      }
      if (titleEl && titles[currentIndex]) {
        titleEl.textContent = titles[currentIndex];
      }
      if (excerptEl && excerpts[currentIndex]) {
        excerptEl.textContent = excerpts[currentIndex];
      }
    }

    prevBtn.addEventListener('click', () => {
      currentIndex = currentIndex > 0 ? currentIndex - 1 : totalSlides - 1;
      updateSlide();
    });

    nextBtn.addEventListener('click', () => {
      currentIndex = currentIndex < totalSlides - 1 ? currentIndex + 1 : 0;
      updateSlide();
    });

    // Fitur Play Bersih (controls=0) Tanpa Garis Player Bertumpuk di Tengah
    const facadeCards = document.querySelectorAll('.yt-facade-card');
    facadeCards.forEach((card) => {
      card.addEventListener('click', () => {
        const videoId = card.getAttribute('data-video-id');
        if (videoId) {
          card.innerHTML = `
            <iframe
              src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&controls=0&modestbranding=1&rel=0"
              title="YouTube Video Player"
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          `;
        }
      });
    });
  }

  initYtCarousel();
  document.addEventListener('astro:page-load', initYtCarousel);
</script>

