---
import { siteConfig } from "@/config/site";
---

<footer class="mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Kontainer utama dipaksa flex-col & items-center di semua ukuran layar -->
    <div class="flex flex-col items-center justify-center text-center gap-6">
      <!-- Brand Name & Description -->
      <div
        class="flex flex-col items-center justify-center text-center gap-2 max-w-md mx-auto"
      >
        <span class="text-xl font-bold text-black dark:text-white">
          {siteConfig.name}
        </span>
        <p class="text-sm font-medium text-slate-800 dark:text-slate-200 text-center leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Social Links (Dengan Touch Target 44px+ & ARIA Label) -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {
          siteConfig.socialLinks?.twitter && (
            <a
              href={siteConfig.socialLinks.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Kunjungi akun Twitter ${siteConfig.name}`}
              class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 py-2 text-sm font-bold text-black dark:text-white transition-colors hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg"
            >
              Twitter
            </a>
          )
        }
        {
          siteConfig.socialLinks?.github && (
            <a
              href={siteConfig.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Kunjungi profil GitHub ${siteConfig.name}`}
              class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 py-2 text-sm font-bold text-black dark:text-white transition-colors hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg"
            >
              GitHub
            </a>
          )
        }
        {
          siteConfig.socialLinks?.discord && (
            <a
              href={siteConfig.socialLinks.discord}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Bergabung dengan Discord ${siteConfig.name}`}
              class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 py-2 text-sm font-bold text-black dark:text-white transition-colors hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg"
            >
              Discord
            </a>
          )
        }
      </div>
    </div>

    <!-- Copyright (Hitam Solid / High Contrast) -->
    <div
      class="mt-8 border-t border-border pt-8 text-center text-xs font-semibold text-slate-700 dark:text-slate-300"
    >
      &copy; {new Date().getFullYear()}
      {siteConfig.author || siteConfig.name}. All rights reserved.
    </div>
  </div>
</footer>