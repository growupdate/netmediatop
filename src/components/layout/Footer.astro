---
import { siteConfig } from "@/config/site";
---

<footer class="mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Kontainer utama dipaksa flex-col & items-center di semua ukuran layar -->
    <div class="flex flex-col items-center justify-center text-center gap-6">
      <!-- Brand Name & Description -->
      <div
        class="flex flex-col items-center justify-center text-center gap-2 max-w-md mx-auto"
      >
        <span class="text-lg font-bold text-foreground">{siteConfig.name}</span>
        <p class="text-sm text-muted-foreground text-center leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center justify-center gap-6">
        <a
          href={siteConfig.socialLinks.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-primary"
          >Twitter</a
        >
        <a
          href={siteConfig.socialLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-primary"
          >GitHub</a
        >
        <a
          href={siteConfig.socialLinks.discord}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-primary"
          >Discord</a
        >
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="mt-8 border-t border-border pt-8 text-center text-xs text-muted-foreground"
    >
      &copy; {new Date().getFullYear()}
      {siteConfig.author}. All rights reserved.
    </div>
  </div>
</footer>
