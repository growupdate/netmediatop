---
import { siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border bg-background text-foreground transition-colors">
  <!-- Schema.org JSON-LD untuk SEO/AEO/GEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "NetMediaTop",
      "url": "https://netmediatop.com",
      "logo": "https://netmediatop.com/favicon.svg",
      "description": "Agensi digital marketing terpadu spesialis Jasa SEO, Pembuatan Website, Google Ads, Meta Ads, dan Konten Digital.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kudus",
        "addressRegion": "Jawa Tengah",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-6.8048",
        "longitude": "110.8405"
      },
      "telephone": "+6282329188998",
      "priceRange": "$$",
      "sameAs": [
        "https://www.facebook.com/netmediatop",
        "https://www.instagram.com/netmediatop"
      ]
    }
  </script>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      
      <!-- Kolom 1: Profil Entitas (GEO Focus) -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold tracking-tight text-foreground">
          {siteConfig.name || "NetMediaTop"}
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground">
          NetMediaTop adalah agensi digital marketing terpadu yang membantu bisnis meningkatkan visibilitas online, lalu lintas organik, dan konversi penjualan melalui layanan SEO, iklan berbayar, dan pembuatan website performa tinggi.
        </p>
      </div>

      <!-- Kolom 2: Layanan Utama (SEO & Internal Linking) -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-foreground">
          Layanan Utama
        </h4>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li>
            <a href="/services/jasa-pembuatan-website" class="transition-colors hover:text-primary">
              🚀 Jasa Pembuatan Website
            </a>
          </li>
          <li>
            <a href="/services/jasa-seo" class="transition-colors hover:text-primary">
              📈 Jasa SEO Bergaransi
            </a>
          </li>
          <li>
            <a href="/services/jasa-iklan-google-ads" class="transition-colors hover:text-primary">
              🎯 Jasa Google Ads
            </a>
          </li>
          <li>
            <a href="/services/jasa-iklan-facebook" class="transition-colors hover:text-primary">
              📱 Jasa Iklan Facebook (Meta)
            </a>
          </li>
          <li>
            <a href="/services/jasa-konten-sosmed" class="transition-colors hover:text-primary">
              ✍️ Jasa Konten Sosmed
            </a>
          </li>
          <li>
            <a href="/services/penulis-artikel" class="transition-colors hover:text-primary">
              📄 Penulis Artikel SEO
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 3: Perusahaan & Keabsahan (EEAT & Transparency) -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-foreground">
          Perusahaan
        </h4>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li>
            <a href="/about" class="transition-colors hover:text-primary">
              Tentang Kami
            </a>
          </li>
          <li>
            <a href="/contact" class="transition-colors hover:text-primary">
              Hubungi Kami
            </a>
          </li>
          <li>
            <a href="/blog" class="transition-colors hover:text-primary">
              Wawasan & Blog
            </a>
          </li>
          <li>
            <a href="/privacy-policy" class="transition-colors hover:text-primary">
              Kebijakan Privasi
            </a>
          </li>
          <li>
            <a href="/terms" class="transition-colors hover:text-primary">
              Syarat & Ketentuan
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 4: AI & Agentic Resources (AEO / GEO Focus) -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-foreground">
          Sumber Daya AI
        </h4>
        <p class="text-xs text-muted-foreground">
          Dokumen terstruktur & manifest untuk pembacaan LLM dan AI Agents:
        </p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li>
            <a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
              🗺️ XML Sitemap Index
            </a>
          </li>
          <li>
            <a href="/llms.txt" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
              🤖 LLMs.txt (AI Index)
            </a>
          </li>
          <li>
            <a href="/.well-known/ard.json" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
              ⚡ ARD Manifest (Agentic)
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: NAP (Name, Address, Phone) & Copyright -->
    <div class="mt-12 border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-muted-foreground gap-4">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-4 gap-y-2">
        <span>📍 Kudus, Jawa Tengah, Indonesia</span>
        <span class="hidden sm:inline">•</span>
        <span>📞 WA: <a href="https://wa.me/6282329188998" target="_blank" class="hover:text-primary underline decoration-dashed">+62 823-2918-8998</a></span>
        <span class="hidden sm:inline">•</span>
        <span>✉️ Email: info@netmediatop.com</span>
      </div>
      <div class="text-center md:text-right">
        &copy; {currentYear} NetMediaTop. All rights reserved.
      </div>
    </div>

  </div>
</footer>