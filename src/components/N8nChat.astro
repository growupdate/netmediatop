<div id="n8n-chat-launcher-group" transition:persist>
  <div id="n8n-chat-invite" class="is-hidden" aria-hidden="true">
    <span id="n8n-chat-invite-text">Ada pertanyaan? Tanya Tri di sini!</span>
  </div>
  <button
    id="n8n-chat-launcher"
    type="button"
    aria-label="Buka chat dengan Tri"
    title="Buka chat dengan Tri"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"
      ></path>
    </svg>
  </button>
</div>
<span id="n8n-chat-status" class="sr-only" role="status" aria-live="polite"
></span>
<div id="n8n-chat" transition:persist></div>

<style>
  #n8n-chat-launcher-group {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  #n8n-chat-invite {
    position: relative;
    max-width: min(calc(100vw - 32px), 220px);
    padding: 7px 10px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
    color: #1e293b;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }
  #n8n-chat-invite::after {
    position: absolute;
    right: 14px;
    bottom: -5px;
    width: 9px;
    height: 9px;
    transform: rotate(45deg);
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    background: #fff;
    content: "";
  }
  #n8n-chat-invite.is-hidden {
    transform: translateY(6px) scale(0.96);
    opacity: 0;
  }
  :global(html.dark #n8n-chat-invite) {
    border-color: #1e293b;
    background: #0f172a;
    color: #f1f5f9;
  }
  :global(html.dark #n8n-chat-invite::after) {
    border-color: #1e293b;
    background: #0f172a;
  }
  #n8n-chat-launcher {
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: #2563eb;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  #n8n-chat-launcher:hover {
    background: #1d4ed8;
  }
  #n8n-chat-launcher:focus-visible {
    outline: 3px solid #93c5fd;
    outline-offset: 3px;
  }
  #n8n-chat-launcher svg {
    width: 20px;
    height: 20px;
  }
  #n8n-chat {
    --chat--toggle--size: 44px;
    --chat--toggle--width: 44px;
    --chat--toggle--height: 44px;
  }
  :global(#n8n-chat .chat-window-toggle svg) {
    width: 20px;
    height: 20px;
  }
  #n8n-chat-launcher-group[hidden] {
    display: none;
  }
  @media (max-width: 480px) {
    #n8n-chat-launcher-group {
      right: 16px;
      bottom: 16px;
    }
    #n8n-chat-invite {
      max-width: calc(50vw - 24px);
    }
  }
</style>

<script>
  type ServiceInfo = {
    key: string;
    label: string;
    link: string;
    ebook: string;
  };

  // ===== MAPPING 6 LAYANAN ASLI NETMEDIATOP =====
  const SERVICE_MAP: Record<string, ServiceInfo> = {
    "jasa-pembuatan-website": {
      key: "jasa-pembuatan-website",
      label: "Website",
      link: "https://netmediatop.com/services/jasa-pembuatan-website",
      ebook: "Website yang Bikin Orang Langsung Chat WA",
    },
    "jasa-seo": {
      key: "jasa-seo",
      label: "SEO",
      link: "https://netmediatop.com/services/jasa-seo",
      ebook: "Cara Muncul di Google dan AI Search Tanpa Iklan Terus",
    },
    "jasa-iklan-google-ads": {
      key: "jasa-iklan-google-ads",
      label: "Google Ads",
      link: "https://netmediatop.com/services/jasa-iklan-google-ads",
      ebook: "Google Ads yang Tidak Boncos",
    },
    "jasa-iklan-facebook": {
      key: "jasa-iklan-facebook",
      label: "Meta Ads",
      link: "https://netmediatop.com/services/jasa-iklan-facebook",
      ebook: "Berhenti Boost Post, Mulai Meta Ads yang Terukur",
    },
    "jasa-konten-sosmed": {
      key: "jasa-konten-sosmed",
      label: "Konten Sosmed",
      link: "https://netmediatop.com/services/jasa-konten-sosmed",
      ebook: "Sosmed Rapi Tanpa Ganggu Operasional",
    },
    "penulis-artikel": {
      key: "penulis-artikel",
      label: "Penulis Artikel",
      link: "https://netmediatop.com/services/penulis-artikel",
      ebook: "Artikel Blog yang Jadi Magnet Pelanggan",
    },
    default: {
      key: "default",
      label: "Bisnis",
      link: "https://netmediatop.com/services/",
      ebook: "Website yang Bikin Orang Langsung Chat WA",
    },
  };

  function getServiceFromPath(path: string): ServiceInfo {
    const p = (path || "").toLowerCase();
    for (const key of Object.keys(SERVICE_MAP)) {
      if (key !== "default" && p.includes(key)) return SERVICE_MAP[key];
    }
    return SERVICE_MAP["default"];
  }

  let chatInitialized = false;
  let chatLoading = false;
  const chatInviteTexts = [
    "Mau bisnis lebih Maju? Tanya  di sini!",
    "Punya web tapi 0 trafik?",
    "Cari layanan yang cocok?",
    "Konsultasi bisnis? siap bantu.",
    "Ceritakan kebutuhan bisnis Anda!",
  ];
  let chatInviteIndex = 0;
  let chatInviteShowTimer: number | undefined;
  let chatInviteRotation: number | undefined;

  function startChatInviteRotation() {
    const bubble = document.getElementById("n8n-chat-invite");
    const bubbleText = document.getElementById("n8n-chat-invite-text");
    if (!bubble || !bubbleText) return;

    chatInviteShowTimer = window.setTimeout(() => {
      bubble.classList.remove("is-hidden");
      chatInviteRotation = window.setInterval(() => {
        bubble.classList.add("is-hidden");
        window.setTimeout(() => {
          chatInviteIndex = (chatInviteIndex + 1) % chatInviteTexts.length;
          bubbleText.textContent = chatInviteTexts[chatInviteIndex];
          bubble.classList.remove("is-hidden");
        }, 300);
      }, 7000);
    }, 1000);
  }

  function stopChatInviteRotation() {
    if (chatInviteShowTimer !== undefined) {
      window.clearTimeout(chatInviteShowTimer);
    }
    if (chatInviteRotation !== undefined) {
      window.clearInterval(chatInviteRotation);
    }
  }

  async function loadAndOpenChat(launcher: HTMLButtonElement) {
    if (chatLoading) return;

    chatLoading = true;
    launcher.disabled = true;
    launcher.setAttribute("aria-busy", "true");
    launcher.title = "Memuat chat...";
    const status = document.getElementById("n8n-chat-status");
    if (status) status.textContent = "Memuat chat...";

    try {
      if (!chatInitialized) {
        await import("@n8n/chat/style.css");
        const { createChat } = await import("@n8n/chat");
        const service = getServiceFromPath(window.location.pathname);

        createChat({
          target: "#n8n-chat",
          webhookUrl:
            "https://ai.netmediatop.com/webhook/0fd4eae5-5551-4cd5-88b3-15bca5d25155/chat",
          mode: "window",
          initialMessages: [
            "Saya Tri, Tim NetMediaTop. Silakan ngobrol santai, bagaimana saya bisa bantu bisnis Anda tumbuh lebih baik?",
          ],
          defaultLanguage: "id" as unknown as "en",
          metadata: {
            sourceUrl: window.location.href,
            sourcePage: window.location.pathname,
            serviceKey: service.key,
            serviceLink: service.link,
            serviceLabel: service.label,
            ebookTitle: service.ebook,
          },
          i18n: {
            id: {
              title: "Tri - Tim NetMediaTop",
              subtitle:
                "Ngobrol santai soal website, SEO, dan cara bikin bisnis makin laris.",
              footer: "",
              getStarted: "Mulai Ngobrol",
              inputPlaceholder: "Tulis pesan Anda...",
              closeButtonTooltip: "Tutup chat",
            },
          },
        });
        chatInitialized = true;
      }

      const chatToggle = document.querySelector<HTMLElement>(
        "#n8n-chat .chat-window-toggle",
      );
      if (!chatToggle) {
        throw new Error("n8n chat toggle was not mounted");
      }

      chatToggle.click();
      stopChatInviteRotation();
      document
        .getElementById("n8n-chat-launcher-group")
        ?.setAttribute("hidden", "");
      if (status) status.textContent = "";
    } catch (error) {
      console.error("Unable to load the n8n chat widget.", error);
      launcher.title = "Chat gagal dimuat. Klik untuk mencoba lagi.";
      if (status) status.textContent = launcher.title;
    } finally {
      chatLoading = false;
      launcher.disabled = false;
      launcher.removeAttribute("aria-busy");
    }
  }

  startChatInviteRotation();

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const launcher =
      event.target.closest<HTMLButtonElement>("#n8n-chat-launcher");
    if (launcher) void loadAndOpenChat(launcher);
  });
</script>
