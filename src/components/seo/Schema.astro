---
import { siteConfig } from "@/config/site";

interface Props {
  type: "WebSite" | "BlogPosting" | "BreadcrumbList" | "FAQ";
  data: {
    title?: string;
    description?: string;
    image?: string;
    pubDate?: Date;
    modDate?: Date;
    author?: string;
    url?: string;
    wordCount?: number;
    readingTime?: number;
    category?: string;
    tags?: string[];
    breadcrumbs?: { name: string; url: string }[];
    faqs?: { question: string; answer: string }[];
  };
}

const { type, data } = Astro.props;

let schema: Record<string, unknown> = {};

if (type === "WebSite") {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    author: {
      "@type": "Person",
      name: siteConfig.author,
    },
    sameAs: [siteConfig.socialLinks.twitter, siteConfig.socialLinks.github],
  };
} else if (type === "BlogPosting") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    image: data.image
      ? new URL(data.image, siteConfig.url).toString()
      : new URL("/og-image.png", siteConfig.url).toString(),
    datePublished: data.pubDate,
    dateModified: data.modDate || data.pubDate,
    author: {
      "@type": "Person",
      name: data.author || siteConfig.author,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", siteConfig.url).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    wordCount: data.wordCount,
    timeRequired: data.readingTime ? `PT${data.readingTime}M` : undefined,
    articleSection: data.category,
    keywords: data.tags ? data.tags.join(", ") : undefined,
  };
} else if (type === "BreadcrumbList") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: (data.breadcrumbs || []).map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.url, siteConfig.url).toString(),
    })),
  };
} else if (type === "FAQ") {
  schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (data.faqs || []).map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
