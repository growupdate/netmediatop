---
import { siteConfig } from "@/config/site";

interface Props {
  type:
    | "WebSite"
    | "BlogPosting"
    | "BreadcrumbList"
    | "FAQ"
    | "Person"
    | "Organization";
  data: {
    title?: string;
    description?: string;
    image?: string;
    pubDate?: Date;
    modDate?: Date;
    author?: string;
    url?: string;
    wordCount?: number;
    readingTime?: number;
    category?: string;
    tags?: string[];
    breadcrumbs?: { name: string; url: string }[];
    faqs?: { question: string; answer: string }[];
  };
}

const { type, data } = Astro.props;

let schema: Record<string, unknown> = {};

const authorSchema = {
  "@type": "Person",
  name: siteConfig.author,
  url: siteConfig.url + "/about",
  jobTitle: siteConfig.authorTitle,
  description: siteConfig.authorBio,
  knowsAbout: siteConfig.authorExpertise,
  sameAs: [
    siteConfig.socialLinks.twitter,
    siteConfig.socialLinks.github,
    siteConfig.socialLinks.linkedin,
    siteConfig.socialLinks.youtube,
  ],
};

if (type === "WebSite") {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    author: authorSchema,
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      url: siteConfig.url,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", siteConfig.url).toString(),
      },
    },
  };
} else if (type === "BlogPosting") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    image: data.image
      ? new URL(data.image, siteConfig.url).toString()
      : new URL("/og-image.png", siteConfig.url).toString(),
    datePublished: data.pubDate,
    dateModified: data.modDate || data.pubDate,
    author: {
      ...authorSchema,
      name: data.author || siteConfig.author,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      url: siteConfig.url,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", siteConfig.url).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    wordCount: data.wordCount,
    timeRequired: data.readingTime ? `PT${data.readingTime}M` : undefined,
    articleSection: data.category,
    keywords: data.tags ? data.tags.join(", ") : undefined,
    inLanguage: "id-ID",
  };
} else if (type === "BreadcrumbList") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: (data.breadcrumbs || []).map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.url, siteConfig.url).toString(),
    })),
  };
} else if (type === "FAQ") {
  schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (data.faqs || []).map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
} else if (type === "Person") {
  schema = {
    "@context": "https://schema.org",
    ...authorSchema,
  };
} else if (type === "Organization") {
  schema = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    image: new URL("/og-image.png", siteConfig.url).toString(),
    founder: authorSchema,
    areaServed: "Indonesia",
    knowsAbout: siteConfig.authorExpertise,
    sameAs: [
      siteConfig.socialLinks.facebook,
      siteConfig.socialLinks.instagram,
      siteConfig.socialLinks.youtube,
      siteConfig.socialLinks.twitter,
      siteConfig.socialLinks.linkedin,
    ],
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
