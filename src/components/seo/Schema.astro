---
import { siteConfig } from "@/config/site";

interface Props {
  type:
    | "WebSite"
    | "BlogPosting"
    | "BreadcrumbList"
    | "FAQ"
    | "Person"
    | "Organization";
  data?: {
    title?: string;
    name?: string;
    description?: string;
    image?: string;
    logo?: string;
    pubDate?: Date;
    modDate?: Date;
    author?: string;
    url?: string;
    wordCount?: number;
    readingTime?: number;
    category?: string;
    tags?: string[];
    breadcrumbs?: { name: string; url: string }[];
    faqs?: { question: string; answer: string }[];
    foundingDate?: string;
    founder?: Record<string, unknown> | string;
    address?: Record<string, unknown> | string;
    contactPoint?: Record<string, unknown>;
    telephone?: string;
    sameAs?: string[];
    areaServed?: string;
    knowsAbout?: string[];
    [key: string]: unknown;
  };
}

const { type, data = {} } = Astro.props;

let schema: Record<string, unknown> = {};

const baseUrl = siteConfig.url || "https://netmediatop.com";

const authorSchema = {
  "@type": "Person",
  name: siteConfig.author || "Tri Pudjo",
  url: baseUrl + "/about",
  jobTitle: siteConfig.authorTitle || "Founder Netmediatop",
  description: siteConfig.authorBio || siteConfig.description,
  knowsAbout: siteConfig.authorExpertise || ["SEO", "Web Development", "Google Ads"],
  sameAs: [
    siteConfig.socialLinks?.twitter,
    siteConfig.socialLinks?.github,
    siteConfig.socialLinks?.linkedin,
    siteConfig.socialLinks?.youtube,
  ].filter(Boolean),
};

if (type === "WebSite") {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: data.name || siteConfig.name,
    url: data.url || baseUrl,
    description: data.description || siteConfig.description,
    author: authorSchema,
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      url: baseUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL(data.logo || "/favicon.svg", baseUrl).toString(),
      },
    },
  };
} else if (type === "BlogPosting") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    image: data.image
      ? new URL(data.image, baseUrl).toString()
      : new URL("/og-image.png", baseUrl).toString(),
    datePublished: data.pubDate,
    dateModified: data.modDate || data.pubDate,
    author: {
      ...authorSchema,
      name: data.author || siteConfig.author,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      url: baseUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", baseUrl).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url || baseUrl,
    },
    wordCount: data.wordCount,
    timeRequired: data.readingTime ? `PT${data.readingTime}M` : undefined,
    articleSection: data.category,
    keywords: data.tags ? data.tags.join(", ") : undefined,
    inLanguage: "id-ID",
  };
} else if (type === "BreadcrumbList") {
  schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: (data.breadcrumbs || []).map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.url, baseUrl).toString(),
    })),
  };
} else if (type === "FAQ") {
  schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (data.faqs || []).map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
} else if (type === "Person") {
  schema = {
    "@context": "https://schema.org",
    ...authorSchema,
    ...(data.name ? { name: data.name } : {}),
  };
} else if (type === "Organization") {
  schema = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: data.name || siteConfig.name,
    url: data.url || baseUrl,
    description: data.description || siteConfig.description,
    image: data.image
      ? new URL(data.image, baseUrl).toString()
      : new URL("/og-image.png", baseUrl).toString(),
    logo: data.logo
      ? new URL(data.logo, baseUrl).toString()
      : new URL("/favicon.svg", baseUrl).toString(),
    foundingDate: data.foundingDate || "2020-01-08",
    founder: data.founder || authorSchema,
    address: data.address,
    contactPoint: data.contactPoint,
    telephone: data.telephone,
    areaServed: data.areaServed || "Indonesia",
    knowsAbout: data.knowsAbout || siteConfig.authorExpertise,
    sameAs: data.sameAs || [
      siteConfig.socialLinks?.facebook,
      siteConfig.socialLinks?.instagram,
      siteConfig.socialLinks?.youtube,
      siteConfig.socialLinks?.twitter,
      siteConfig.socialLinks?.linkedin,
    ].filter(Boolean),
  };
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />