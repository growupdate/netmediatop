---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const allPosts = await getCollection('blog');

// Gunakan post.id saja untuk versi Astro terbaru
const relatedPosts = allPosts
  .filter((post) => post.id !== currentSlug)
  .slice(0, 3);
---

{relatedPosts.length > 0 && (
  <section class="mt-12 border-t border-border pt-8">
    <h3 class="text-2xl font-bold mb-6 text-foreground">Artikel Terkait Lainnya</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedPosts.map((post) => {
        const postSlug = post.id;
        const postImage = post.data.image;
        
        return (
          <article class="bg-card border border-border rounded-lg overflow-hidden flex flex-col justify-between shadow-sm hover:shadow-md transition">
            <div>
              {postImage && (
                <a href={`/blog/${postSlug}`} class="block overflow-hidden h-40 w-full bg-muted">
                  <img 
                    src={postImage} 
                    alt={post.data.title} 
                    class="h-full w-full object-cover hover:scale-105 transition duration-300"
                    loading="lazy"
                  />
                </a>
              )}
              
              <div class="p-4">
                <h4 class="font-semibold text-lg mb-2">
                  <a href={`/blog/${postSlug}`} class="text-foreground hover:text-primary transition">
                    {post.data.title}
                  </a>
                </h4>
                <p class="text-sm text-muted-foreground line-clamp-2">
                  {post.data.description}
                </p>
              </div>
            </div>

            <div class="p-4 pt-0">
              <a href={`/blog/${postSlug}`} class="text-sm font-medium text-primary hover:underline">
                Baca Selengkapnya &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
)}