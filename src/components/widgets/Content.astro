---
import type { ImageMetadata } from 'astro';

interface Item {
  title: string;
  description: string;
  icon?: string;
  iconClass?: string;
}

interface Action {
  text: string;
  href: string;
  variant?: string;
  icon?: string;
  ariaLabel?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  description?: string | string[];
  items?: Item[];
  actions?: Action[];
  image?: ImageMetadata | string;
  imageAlt?: string;
  isReversed?: boolean;
}

const {
  title,
  subtitle,
  tagline,
  content,
  description,
  items = [],
  actions = [],
  image,
  imageAlt = "Content Image",
  isReversed = false,
} = Astro.props;
---

<section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class={`grid grid-cols-1 md:grid-cols-2 gap-12 items-center ${isReversed ? 'md:flex-row-reverse' : ''}`}>
    
    {image && (
      <div class={`relative ${isReversed ? 'md:order-2' : ''}`}>
        <img
          src={typeof image === 'string' ? image : image.src}
          alt={imageAlt}
          class="w-full h-auto rounded-xl shadow-lg object-cover"
          loading="lazy"
        />
      </div>
    )}

    <div class={`space-y-6 ${isReversed ? 'md:order-1' : ''}`}>
      {tagline && (
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">
          {tagline}
        </span>
      )}
      
      {title && (
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          {title}
        </h2>
      )}

      {subtitle && (
        <p class="text-lg text-muted-foreground">
          {subtitle}
        </p>
      )}

      {typeof description === 'string' && (
        <p class="text-muted-foreground text-base">{description}</p>
      )}
      {Array.isArray(description) && description.map((desc) => (
        <p class="text-muted-foreground text-base">{desc}</p>
      ))}

      <slot />

      {content && <p class="text-muted-foreground text-base">{content}</p>}

      {/* Render Actions jika ada */}
      {actions.length > 0 && (
        <div class="flex flex-wrap gap-4 pt-2">
          {actions.map((action) => (
            <a
              href={action.href}
              class={`inline-flex items-center justify-center px-5 py-3 rounded-lg font-medium transition-colors ${
                action.variant === 'secondary'
                  ? 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
                  : 'bg-primary text-primary-foreground hover:bg-primary/90'
              }`}
            >
              {action.text}
            </a>
          ))}
        </div>
      )}

      {items.length > 0 && (
        <div class="space-y-4 pt-2">
          {items.map((item) => (
            <div class="flex items-start gap-4 p-4 rounded-lg bg-card border border-border shadow-xs">
              {item.icon && (
                <div class={`p-3 rounded-md shrink-0 ${item.iconClass || 'bg-primary/10 text-primary'}`}>
                  <span class="text-xl">🔹</span>
                </div>
              )}
              <div>
                <h3 class="font-bold text-foreground text-base mb-1">{item.title}</h3>
                <p class="text-sm text-muted-foreground">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</section>
