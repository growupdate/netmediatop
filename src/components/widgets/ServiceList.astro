---
const { services = [] } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  {services.map((s: unknown) => {
    const typedService = s as { href?: string; link?: string; title?: string; description?: string };
    const serviceLink = typedService.href || typedService.link || "#";
    
    return (
      <a href={serviceLink} class="block group p-6 bg-card border border-border rounded-lg shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-foreground mb-2">{typedService.title}</h3>
        <p class="text-muted-foreground text-sm">{typedService.description}</p>
      </a>
    );
  })}
</div>