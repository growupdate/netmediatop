---
// src/components/ui/WhatsAppWidget.astro
interface Props {
  phoneNumber?: string;
  message?: string;
}

const {
  phoneNumber = "628329188998",
  message = "Halo NetMediaTop, saya ingin berkonsultasi mengenai layanan digital marketing.",
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
const waUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
---

<div
  class="fixed bottom-5 right-5 z-50 flex flex-col items-end pointer-events-none"
>
  <!-- Speech Bubble Promo Melayang -->
  <div
    id="waBubble"
    class="pointer-events-auto mb-2 transform rounded-xl bg-white px-3 py-1.5 text-xs font-semibold text-slate-800 shadow-lg border border-slate-200/80 transition-all duration-500 ease-in-out opacity-0 translate-y-2 scale-95 dark:bg-slate-900 dark:text-slate-100 dark:border-slate-800 relative flex items-center gap-2"
  >
    <!-- Indicator Dot Hijau Animasi -->
    <span class="relative flex h-2 w-2 shrink-0">
      <span
        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
      ></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
      ></span>
    </span>

    <!-- Teks Promo -->
    <span id="waBubbleText" class="whitespace-nowrap"
      >Ayo Ngobrol Santai 🚀</span
    >

    <!-- Ekor Panah Bubble -->
    <div
      class="absolute -bottom-1 right-4 h-2.5 w-2.5 rotate-45 bg-white border-b border-r border-slate-200/80 dark:bg-slate-900 dark:border-slate-800"
    >
    </div>
  </div>

  <!-- Tombol WhatsApp Ringkas (44px) -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat via WhatsApp"
    class="pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full bg-[#25D366] text-white shadow-md transition-all duration-300 hover:scale-110 hover:bg-[#20ba5a] hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-green-300"
  >
    <svg
      class="h-6 w-6 fill-current"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 448 512"
    >
      <path
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
      ></path>
    </svg>
  </a>
</div>

<script>
  function initWABubble() {
    const promoTexts = [
      "Konsultasi Gratis 🚀",
      "Mau Buat Web + SEO 📈",
      "Mau Coba Google Ads 🎯",
      "Mau Audit Web+SEO 🔥",
      "Mau Bisnis +Lancar? 💬",
    ];

    const bubble = document.getElementById("waBubble");
    const bubbleText = document.getElementById("waBubbleText");
    if (!bubble || !bubbleText) return;

    let index = 0;

    function rotateText() {
      bubble?.classList.add("opacity-0", "translate-y-2", "scale-95");
      bubble?.classList.remove("opacity-100", "translate-y-0", "scale-100");

      setTimeout(() => {
        if (bubbleText) {
          bubbleText.textContent = promoTexts[index];
        }
        index = (index + 1) % promoTexts.length;

        bubble?.classList.remove("opacity-0", "translate-y-2", "scale-95");
        bubble?.classList.add("opacity-100", "translate-y-0", "scale-100");
      }, 500);
    }

    setTimeout(() => {
      rotateText();
      setInterval(rotateText, 7000);
    }, 1000);
  }

  initWABubble();
  document.addEventListener("astro:page-load", initWABubble);
</script>
